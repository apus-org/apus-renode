using "platforms/cpus/stm32f072.repl"

// 8 MHz crystal, PLL to 48 MHz, AHB and APB undivided

// measured on the board: 0.50-0.58 instructions per cycle in delay loops, GPIO writes and copies

cpu:
    PerformanceInMips: 24

nvic:
    systickFrequency: 48_000_000

timer1:
    frequency: 48_000_000

timer2:
    frequency: 48_000_000

timer3:
    frequency: 48_000_000

timer6:
    frequency: 48_000_000

timer7:
    frequency: 48_000_000

timer14:
    frequency: 48_000_000

timer15:
    frequency: 48_000_000

timer16:
    frequency: 48_000_000

timer17:
    frequency: 48_000_000

usart1:
    frequency: 48_000_000

usart2:
    frequency: 48_000_000

usart3:
    frequency: 48_000_000

usart4:
    frequency: 48_000_000

// LEDs, active low

led3: Miscellaneous.LED @ gpioPortC 0
    invert: true

led4: Miscellaneous.LED @ gpioPortC 1
    invert: true

led5: Miscellaneous.LED @ gpioPortC 2
    invert: true

// RGB LED on TIM3 CH1–3, common anode

rgbRed: Miscellaneous.LED @ gpioPortC 6
    invert: true

rgbGreen: Miscellaneous.LED @ gpioPortC 7
    invert: true

rgbBlue: Miscellaneous.LED @ gpioPortC 8
    invert: true

// active buzzer, sounds while low

buzzer: Miscellaneous.LED @ gpioPortC 9
    invert: true

gpioPortC:
    0 -> led3@0
    1 -> led4@0
    2 -> led5@0
    6 -> rgbRed@0
    7 -> rgbGreen@0
    8 -> rgbBlue@0
    9 -> buzzer@0

// buttons, active high

wakeUp: Miscellaneous.Button @ gpioPortA 0
    -> gpioPortA@0

user0: Miscellaneous.Button @ gpioPortD 0
    -> gpioPortD@0

user1: Miscellaneous.Button @ gpioPortD 1
    -> gpioPortD@1

// potentiometer RV1 on ADC_IN14, internal reference on ADC_IN17

potentiometer: Analog.ADCChannelSource @ adc 14

vrefint: Analog.ADCChannelSource @ adc 17
    defaultValueMicroVolts: 1_230_000

// factory calibration: VREFINT_CAL = 1.23 V / 3.3 V * 4095 at 0x1FFF_F7BA

systemMemory: Memory.MappedMemory @ sysbus 0x1FFF_C800
    size: 0x3000
    init:
        WriteWord 0x2FBA 1526
