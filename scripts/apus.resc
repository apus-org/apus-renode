:name: APUS
:description: Runs an ELF on the APUS board. Set $bin first.

$name?="apus"

include $ORIGIN/../peripherals/STM32F0_SPI.cs $ORIGIN/../peripherals/MCP9803.cs $ORIGIN/../peripherals/MCP79410.cs $ORIGIN/../peripherals/ST7789V.cs $ORIGIN/../peripherals/TSC2046.cs

mach create $name
machine LoadPlatformDescription $ORIGIN/../platforms/boards/apus.repl

macro reset
"""
    sysbus LoadELF $bin
"""

runMacro $reset
